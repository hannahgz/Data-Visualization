// Represents a numeric color scale.
class ColorScale {
	
	// In this constructor, the "colors" and "numbers" parameters
	// need to be arrays of the same length.
	// They should hold (can you guess?) colors and numbers.
	// "numbers" should be sorted in ascending order.
	constructor(colors, numbers) {
		this.colors = colors;
		this.numbers = numbers;
	}
	
	// Minimum numeric value for scale.
	getMin() {
		return this.numbers[0];
	}
	
	// Maximum numeric value for scale.
	getMax() {
		return this.numbers[this.numbers.length - 1];
	}
	
	// Return the appropriate color for the given number
	getColor(x) {
		let numColors = this.numbers.length;
		// If the number is off the ends of the scale,
		// return the appropriate extreme value.
		if (x <= this.getMin()) {
			return this.colors[0];
		}
		if (x >= this.getMax()) {
			return this.colors[numColors - 1];
		}
		
		// Otherwise go through numbers array and find which segment we should use;
		// return an appropriate color via linear interpolation.
		for (let i = 1; i < numColors; i++) {
			if (x <= this.numbers[i]) {
				let t = (x - this.numbers[i - 1]) / (this.numbers[i] - this.numbers[i - 1]);
				return lerpColor(this.colors[i - 1], this.colors[i], t);
			}
		}
	}
}

// Convenience function to draw a color scale object
// at a given point on the screen.
// One design option (not taken here) would be to make this
// function a method of the ColorScale class--but in that case
// you'd probably want to make it a little more general.
function drawScale(scale, x, y, w) {
	push();
	// Draw a color spectrum, one line for each available pixel.
	for (let i = 0; i < w; i++) {
		// Use linear interpolation between min and max of scale
		// to figure out what value to draw at this part of spectrum
		let t = lerp(scale.getMin(), scale.getMax(), i / (w + 1));
		strokeWeight(2);
		stroke(scale.getColor(t));
		line(x + i, y, x + i, y + 40);
	}
	pop();
	
	// Label min and max values of color scale.
	fill(255);
	noStroke();
	textSize(16);
	textAlign(LEFT, BASELINE);
	text(round(scaleMin), x, y - 5);
	textAlign(RIGHT, BASELINE);
	text(round(scaleMax), x + w, y - 5);
	// textAlign(CENTER, BASELINE);
	// // text("Average Distance to Nearest Abortion Facility (miles)", x + (w/2), y + 25);
	// text("Average Distance to", x + (w/2), y + 55);
	// text("Nearest Abortion Facility (miles)", x + (w/2), y + 75);
}


// Custom Slider class
class Slider {
  constructor(x, y, w, min, max, startValue) {
    this.x = x;                   // Slider x position
    this.y = y;                   // Slider y position
    this.width = w;               // Slider width
    this.minVal = min;            // Minimum value of the slider
    this.maxVal = max;            // Maximum value of the slider
    this.value = startValue;      // Current slider value
    this.thumbRadius = 10;        // Radius of the thumb
    this.dragging = false;        // Whether the slider thumb is being dragged
    this.numSteps = max - min + 1; // Total steps for discrete values
  }

  // Display the slider track and thumb
  display() {
    // Draw the track
    stroke(180);
    strokeWeight(10);
    line(this.x, this.y, this.x + this.width, this.y);

    // Draw the thumb
    let thumbX = this.getThumbX();
		
		let isHovering = dist(mouseX, mouseY, thumbX, this.y) < this.thumbRadius;
    
		// Draw the thumb with a white outline if hovering
    noStroke();
    if (isHovering || this.dragging) {
      stroke(255);               // White outline
      strokeWeight(4);           // Outline thickness
    }
    fill("rgb(233, 137, 205)");
    ellipse(thumbX, this.y, this.thumbRadius * 2);
    noStroke();

    // // Display the slider value above the thumb
    // noStroke();
    // fill(0);
    // textAlign(CENTER);
    // text("Value: " + this.value, thumbX, this.y - 20);
  }

  // Get the x position of the thumb based on the current value
  getThumbX() {
    return map(this.value, this.minVal, this.maxVal, this.x, this.x + this.width);
  }

  // Handle mouse press to check if the thumb is clicked
  handleMousePressed() {
    let thumbX = this.getThumbX();
    if (dist(mouseX, mouseY, thumbX, this.y) < this.thumbRadius) {
      this.dragging = true;
			state = SPECIFIC;
    }
  }

  // Handle mouse release to stop dragging
  handleMouseReleased() {
    this.dragging = false;
  }

  // Handle mouse drag to update the slider value
  handleMouseDragged() {
    if (this.dragging) {
      // Constrain mouseX within the slider track limits
      let constrainedX = constrain(mouseX, this.x, this.x + this.width);

      // Map the mouse position to the nearest step
      let stepSize = this.width / (this.numSteps - 1);
      let nearestStep = round((constrainedX - this.x) / stepSize);
      this.value = constrain(nearestStep, this.minVal, this.maxVal);
    }
  }
}

function mouseReleased() {
	slider.handleMouseReleased();
}

function mouseDragged() {
	slider.handleMouseDragged();
}

