		// fill(255);
		// textSize(10);
		// textStyle(BOLD);
		// text(this.state, this.x, this.y);
		// textStyle(NORMAL);
  }
	
	showText() {
		noStroke();
		textAlign(CENTER, CENTER);
		fill(255);
		textSize(10);
		textStyle(BOLD);
		text(this.state, this.x, this.y);
		textStyle(NORMAL);
	}
	
