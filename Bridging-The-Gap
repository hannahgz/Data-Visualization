// Define the GrowingRing class
class GrowingRing {
  constructor(x, y, radii, state) {
    this.x = x;
    this.y = y;
    this.state = state;
    this.radii = radii;
    this.currentRadius = radii[0];
    this.startTime = millis(); // Initialize the start time for each ring
		this.selected = false;
  }

  update(sliderIndex) {
    // Calculate elapsed time since the transition started
    let elapsedTime = millis() - this.startTime;

    // Lerp based on both the cycling and the slider
