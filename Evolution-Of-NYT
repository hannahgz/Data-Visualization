	if (scrollY >= minScrolly && scrollY <= maxScrolly) {
		// Get the current scroll position (replace this with your actual scroll value)
  
		// Determine the opacity for the fading effect
		let opacity = 0;

		// Fade in from light to dark between minScrolly and mediumScrolly
		if (scrollY >= minScrolly && scrollY <= minScrolly + 100) {
			opacity = map(scrollY, minScrolly, minScrolly + 100, 0, 255);
		}
		// Fade out from dark to light between mediumScrolly and maxScrolly
		else if (scrollY > maxScrolly - 100 && scrollY <= maxScrolly) {
			opacity = map(scrollY, maxScrolly - 100, maxScrolly, 255, 0);
		} else {
			opacity = 255;
		} 

		// Set the text color with the calculated opacity
		// let currColor = color(0, 0, 0);
		currColor.setAlpha(opacity);

		fill(currColor);
		// Draw the text at the specified position
		wrapTextTemp(currText, x, y, 580, wrapTextSize);
		// text(currText, x, y);
	} 
}

function displayParentingArticles(y) {
	push();
  textSize(10); // Set text size
	textAlign(LEFT, CENTER)
  let lineHeight = 13; // Line spacing
  let x = 20; // Horizontal position

  for (let i = 0; i < parentingArticles.length; i++) {
    text(parentingArticles[i], x, y + i * lineHeight);
  }
	pop();
}

