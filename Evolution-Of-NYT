function createTreemap(items, x, y, w, h) {
  if (items.length === 0) return [];
  
  if (items.length === 1) {
    return [{ ...items[0], x, y, w, h }];
  }

  let totalValue = items.reduce((sum, item) => sum + item.currentValue, 0);
  let halfValue = totalValue / 2;
  let accumulatedValue = 0;
  let splitIndex = -1;

  for (let i = 0; i < items.length; i++) {
    accumulatedValue += items[i].currentValue;
    if (accumulatedValue >= halfValue) {
      splitIndex = i;
      break;
    }
  }

  let group1 = items.slice(0, splitIndex + 1);
  let group2 = items.slice(splitIndex + 1);

  if (w > h) {
    let group1Width = (accumulatedValue / totalValue) * w;
    return [
      ...createTreemap(group1, x, y, group1Width, h),
      ...createTreemap(group2, x + group1Width, y, w - group1Width, h),
    ];
  } else {
    let group1Height = (accumulatedValue / totalValue) * h;
    return [
      ...createTreemap(group1, x, y, w, group1Height),
      ...createTreemap(group2, x, y + group1Height, w, h - group1Height),
    ];
  }
}

function writeTreemapText(item, roundedValue) {
	fill(0);
	textAlign(CENTER, CENTER);
	
	// Calculate the font size based on the area of the item
	let area = item.w * item.h; // Area of the rectangle
	let fontSize = map(area, 1000, 140000, 15, 45); // Map area to font size range

	// Ensure the font size fits within the width of the rectangle
	let maxTextWidth = item.w * 0.8; // Allow for some padding
	textSize(fontSize);
	let textHeight = textAscent() + textDescent();
	while (textWidth(item.name) > maxTextWidth && fontSize > 3) {
		fontSize -= 1; // Reduce font size if the text is too wide
		textSize(fontSize);
	}

	// Draw the name and percentage text inside the rectangle
	noStroke();
	text(item.name, item.x + item.w / 2, item.y + item.h / 2);
	
	textSize(fontSize * (2/3));
	
	let textHeight2 = textAscent() + textDescent();
	if (textHeight2 < item.h *(2/3) - textHeight) {
		text(`${roundedValue}%`, item.x + item.w / 2, item.y + item.h / 2 + fontSize);
	}
}


