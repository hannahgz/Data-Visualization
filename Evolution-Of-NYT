function wrapText(str, x, y, maxWidth, text_size, chosenFont = romanFont, text_align = LEFT, fillColor = color(0, 0, 0)) {
	push();
	noStroke();
	textFont(chosenFont);
  let words = split(str, ' ');
  let currentLine = '';
  let lineHeight = text_size + 3; // Space between lines
  
	textAlign(text_align, CENTER);
	textSize(text_size);
	fill(fillColor);
	// fill(0, 0, 0, 10);
  for (let i = 0; i < words.length; i++) {
    let testLine = currentLine + words[i] + ' ';
    let testWidth = textWidth(testLine);
    
    // If adding this word exceeds the max width, draw the current line and start a new one
    if (testWidth > maxWidth) {
      text(currentLine, x, y);
      currentLine = words[i] + ' '; // Start new line with the current word
      y += lineHeight; // Move down for the next line
    } else {
      currentLine = testLine; // Continue the current line with the word
    }
  }
  
  // Draw any remaining text
  text(currentLine, x, y);
	pop();
}

